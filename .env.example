# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose this value through NEXT_PUBLIC_* variables
SUPABASE_SERVICE_ROLE_KEY=

# Application callback origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kakao credentials belong in Supabase Dashboard > Authentication > Providers.
